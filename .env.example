# ==============================================================================
# Blink - Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to `.env` or configure these variables in your deployment 
# provider settings (Vercel, Netlify, Railway, Render, etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Configuration (Client-side / Frontend)
# ------------------------------------------------------------------------------
# Get these credentials from your Firebase Console -> Project Settings -> General
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-app-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-app-id
VITE_FIREBASE_STORAGE_BUCKET=your-app-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_google_analytics_measurement_id

# ------------------------------------------------------------------------------
# 2. Link Preview API (LinkPreview.net)
# ------------------------------------------------------------------------------
# Used for fetching metadata (titles, descriptions, images) for added links.
# Get an API key from https://www.linkpreview.net/
VITE_LINK_PREVIEW_API_KEY=your_link_preview_api_key

# ------------------------------------------------------------------------------
# 3. Google reCAPTCHA v2 (Client-side)
# ------------------------------------------------------------------------------
# Used for abuse prevention in user & container report forms.
# Google reCAPTCHA v2 "I'm not a robot" Checkbox Site Key.
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v2_site_key

# ------------------------------------------------------------------------------
# 4. Formspree Endpoints (Optional / Form submissions)
# ------------------------------------------------------------------------------
# Endpoints for support messages and reporting forms.
# Get endpoints from https://formspree.io/
VITE_FORMSPREE_SUPPORT_URL=https://formspree.io/f/mojleqkq
VITE_FORMSPREE_REPORT_CONTAINER_URL=https://formspree.io/f/mqeywpqv
VITE_FORMSPREE_REPORT_USER_URL=https://formspree.io/f/xaqpaqky

# ------------------------------------------------------------------------------
# 5. Deployment & Runtime Environment
# ------------------------------------------------------------------------------
# Node.js runtime version for Nixpacks / Railway / Render
NIXPACKS_NODE_VERSION=20
